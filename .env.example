OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Server only: organization Admin API key for the admin Costs page (not OPENAI_API_KEY).
OPENAI_ADMIN_KEY=
# Optional: restrict costs to Studio's OpenAI project; empty means entire organization.
OPENAI_COSTS_PROJECT_ID=
# Standard/detailed Google Cloud Billing export table: project.dataset.gcp_billing_export_v1_ACCOUNT_ID
GOOGLE_CLOUD_BILLING_TABLE=
# Dataset location, e.g. EU, US or europe-west1.
GOOGLE_CLOUD_BILLING_LOCATION=
# Local mode remains available until Firebase is enabled.
NEXT_PUBLIC_FIREBASE_ENABLED=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Enable only after authorizing the app domain and its OAuth redirect URI; see FIREBASE.md.
NEXT_PUBLIC_FIREBASE_AUTH_PROXY=false
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server only: use these credentials or GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
